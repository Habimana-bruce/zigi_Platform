{
  "info": {
    "name": "Zigi USSD Backend",
    "description": "Test the Customers API, the Menu Items API (add/edit/soft-delete/restore menu content), and the USSD gateway-style endpoint. Backend must be running (mvn spring-boot:run) with XAMPP MySQL started and zigi_db imported.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:6157/api/customers"
    },
    {
      "key": "menuUrl",
      "value": "http://localhost:6157/api/menu"
    },
    {
      "key": "ussdUrl",
      "value": "http://localhost:6157/api/ussd"
    },
    {
      "key": "paymentsUrl",
      "value": "http://localhost:6157/api/payments"
    },
    {
      "key": "ussdXmlUrl",
      "value": "http://localhost:6157/api/ussd-xml"
    }
  ],
  "item": [
    {
      "name": "Customers API",
      "item": [
        {
          "name": "1. Get all customers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}"
          }
        },
        {
          "name": "2. Get customer by phone (Balance lookup)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/phone/0781234567"
          }
        },
        {
          "name": "3. Add (create) new customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"phoneNumber\": \"0790000001\",\n  \"mainBalance\": 5000,\n  \"airtimeBalance\": 200,\n  \"dataBalanceMb\": 1024\n}"
            },
            "url": "{{baseUrl}}"
          }
        },
        {
          "name": "4. Edit (update) customer by id",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User Updated\",\n  \"phoneNumber\": \"0790000001\",\n  \"mainBalance\": 9999,\n  \"airtimeBalance\": 300,\n  \"dataBalanceMb\": 2048\n}"
            },
            "url": "{{baseUrl}}/1"
          }
        },
        {
          "name": "5. Soft delete customer by id",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/soft-delete/1"
          }
        },
        {
          "name": "6. View soft-deleted customers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/deleted"
          }
        },
        {
          "name": "7. Restore soft-deleted customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restore/1"
          }
        },
        {
          "name": "8. Hard delete customer by id (permanent)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/1"
          }
        }
      ]
    },
    {
      "name": "Menu Items API (edit chatbot/USSD content)",
      "description": "Everything the chatbot and /api/ussd display comes from these menu_items rows. Add, edit, or soft-delete here and it shows up in both places automatically.",
      "item": [
        {
          "name": "1. Get MAIN menu (top-level)",
          "request": {
            "method": "GET",
            "url": "{{menuUrl}}/roots/MAIN"
          }
        },
        {
          "name": "2. Get HELP menu (top-level)",
          "request": {
            "method": "GET",
            "url": "{{menuUrl}}/roots/HELP"
          }
        },
        {
          "name": "3. Get DATA menu options",
          "request": {
            "method": "GET",
            "url": "{{menuUrl}}/roots/DATA"
          }
        },
        {
          "name": "4. Get AIRTIME menu options",
          "request": {
            "method": "GET",
            "url": "{{menuUrl}}/roots/AIRTIME"
          }
        },
        {
          "name": "5. Get children of 'Hot Deals' (id=3)",
          "request": {
            "method": "GET",
            "url": "{{menuUrl}}/3/children"
          }
        },
        {
          "name": "6. Get one menu item by id",
          "request": {
            "method": "GET",
            "url": "{{menuUrl}}/9"
          }
        },
        {
          "name": "7. Add a new item to Hot Deals (e.g. a new deal type)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": 3,\n  \"groupName\": \"MAIN\",\n  \"label\": \"Weekend Bonus\",\n  \"icon\": \"\\uD83C\\uDF89\",\n  \"responseText\": null,\n  \"actionType\": \"TEXT\",\n  \"sortOrder\": 4\n}"
            },
            "url": "{{menuUrl}}"
          }
        },
        {
          "name": "8. Add a pricing tier under that new item (find its id from step 7's response)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentId\": 50,\n  \"groupName\": \"MAIN\",\n  \"label\": \"1500Frw=10GB\",\n  \"icon\": \"\\uD83C\\uDF89\",\n  \"responseText\": \"You have selected the Weekend Bonus: 1500Frw = 10GB. (demo)\",\n  \"actionType\": \"TEXT\",\n  \"sortOrder\": 1\n}"
            },
            "url": "{{menuUrl}}"
          }
        },
        {
          "name": "9. Edit a menu item's label/response text",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"500Frw = 3GB (Night)\",\n  \"icon\": \"\\uD83D\\uDCBE\",\n  \"responseText\": \"Updated: 500Frw = 3GB Night Offer confirmed. (demo)\",\n  \"actionType\": \"TEXT\",\n  \"sortOrder\": 1\n}"
            },
            "url": "{{menuUrl}}/9"
          }
        },
        {
          "name": "10. Soft delete a menu item by id",
          "request": {
            "method": "POST",
            "url": "{{menuUrl}}/soft-delete/9"
          }
        },
        {
          "name": "11. View soft-deleted menu items",
          "request": {
            "method": "GET",
            "url": "{{menuUrl}}/deleted"
          }
        },
        {
          "name": "12. Restore a soft-deleted menu item",
          "request": {
            "method": "POST",
            "url": "{{menuUrl}}/restore/9"
          }
        },
        {
          "name": "13. Hard delete a menu item by id (permanent)",
          "request": {
            "method": "DELETE",
            "url": "{{menuUrl}}/50"
          }
        }
      ]
    },
    {
      "name": "Payments API",
      "description": "Pipeline: POST /payments creates a Transaction + PaymentAttempt and simulates calling MTN/Airtel (waits ~2.5s), then that simulator calls POST /payments/callback itself (like a real webhook) to resolve it to SUCCESS/FAILED. Poll GET /payments/{id} to watch it change from PENDING. Menu item id 9 = 'Night Offers 500Frw=3GB' (price 500, credits 3072MB data) - use it to test, or pick any id with actionType=PAYMENT from the Menu Items folder.",
      "item": [
        {
          "name": "1. Initiate a payment (Night Offer 500Frw=3GB, item id 9)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"0781234567\",\n  \"menuItemId\": 9,\n  \"provider\": \"MTN\"\n}"
            },
            "url": "{{paymentsUrl}}"
          }
        },
        {
          "name": "2. Poll transaction status (replace 1 with the id returned above)",
          "request": {
            "method": "GET",
            "url": "{{paymentsUrl}}/1"
          }
        },
        {
          "name": "3. Simulate a FAILED payment (phone ending in 0000 always fails)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"0781230000\",\n  \"menuItemId\": 9,\n  \"provider\": \"MTN\"\n}"
            },
            "url": "{{paymentsUrl}}"
          }
        },
        {
          "name": "4. Manually simulate the provider callback yourself (normally the simulator does this automatically)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "transactionId",
                  "value": "1"
                },
                {
                  "key": "externalRef",
                  "value": "MANUAL-TEST-REF"
                },
                {
                  "key": "status",
                  "value": "SUCCESS"
                },
                {
                  "key": "providerMessage",
                  "value": "Manually confirmed via Postman"
                }
              ]
            },
            "url": "{{paymentsUrl}}/callback"
          }
        },
        {
          "name": "5. Buy Airtime tier (item id 46, 500Frw) to test AIRTIME credit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"0781234567\",\n  \"menuItemId\": 46,\n  \"provider\": \"AIRTEL\"\n}"
            },
            "url": "{{paymentsUrl}}"
          }
        },
        {
          "name": "6. Confirm the balance updated (After SUCCESS, check customer)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/phone/0781234567"
          }
        }
      ]
    },
    {
      "name": "USSD Session (step-by-step)",
      "description": "Run in order to walk one real USSD session for *123#. 'text' = everything typed so far, joined with '*'. Response starts with CON (continue) or END (session closes). Top-level menu = MAIN items from the DB (1-4), then Airtime(5), Data(6), Assist(7), Help(8), Exit(0).",
      "item": [
        {
          "name": "1. Dial *123# (text empty, session 1) -> CON main menu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
