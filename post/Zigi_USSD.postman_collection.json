  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-added: renders JSON \"message\" fields with real line breaks",
          "// (JSON strings can't contain literal newlines, so they arrive as \\n -",
          "// this just displays them properly in the Visualize tab instead of the",
          "// Body tab, which still correctly shows the raw \\n as required by JSON).",
          "try {",
          "    const contentType = pm.response.headers.get('Content-Type') || '';",
          "    if (contentType.includes('application/json')) {",
          "        const data = pm.response.json();",
          "        if (data && typeof data.message === 'string') {",
          "            const template = `",
          "                <div style=\"font-family: monospace; font-size: 13px;\">",
          "                    <p><b>sessionId:</b> {{sessionId}}</p>",
          "                    <p><b>status:</b> {{status}}</p>",
          "                    <pre style=\"white-space: pre-wrap; background:#f5f5f5; padding:10px; border-radius:4px;\">{{message}}</pre>",
          "                </div>",
          "            `;",
          "            pm.visualizer.set(template, data);",
          "        }",
          "    }",
          "} catch (e) {",
          "    // not JSON or no message field - nothing to visualize, that's fine",
          "}"
        ]
      }
    }
